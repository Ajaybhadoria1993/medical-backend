# Commented-out lines are optional; the value shown is the default.

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONT_END_URI=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:5000
# LOGIN_URL=https://infinitymedisetu.com/app/login
# Comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://staging.infinitymedisetu.com,https://infinitymedisetu.com

# ── Super admin (seed) ──────────────────────────────────────────────────────
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=your_password
# Non-prod only: "new clinic" emails go here instead of DB super admins (empty = none)
SUPER_ADMIN_NOTIFY_EMAILS=you@example.com,qa@example.com

# ── Auth tokens ─────────────────────────────────────────────────────────────
# Signs access tokens — always set; the code falls back to an insecure default
JWT_SECRET_KEY=your_jwt_secret_key
ACCESS_TOKEN_EXPIRES_IN=15m
# Always set; the code falls back to an insecure default
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=30d
SESSION_CACHE_TTL_SECS=604800

# ── Social login ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_web_client_id
GOOGLE_CLIENT_ID_IOS=your_google_ios_client_id
GOOGLE_CLIENT_ID_ANDRIOD=your_google_android_client_id
# Comma-separated, if web/iOS/Android use different Google clients
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_ID_IOS=com.infinity.medisetu
APPLE_CLIENT_ID_WEB=com.infinity.medisetu.web
APPLE_CLIENT_ID_ANDROID=com.infinity.medisetu.android
# Comma-separated allowed Apple bundle/service IDs
APPLE_CLIENT_IDS=com.infinity.medisetu,com.infinity.medisetu.web

# ── Database (selected by NODE_ENV) ─────────────────────────────────────────
DEV_DB_NAME=your_dev_db_name
DEV_DB_USER=postgres
DEV_DB_PASS=your_dev_db_password
DEV_DB_HOST=localhost
DEV_DB_PORT=5433
DEV_DB_URL=postgresql://postgres:password@localhost:5433/your_dev_db_name

STAGING_DB_NAME=your_staging_db_name
STAGING_DB_USER=your_staging_db_user
STAGING_DB_PASS=your_staging_db_password
STAGING_DB_HOST=your_staging_db_host
STAGING_DB_PORT=5432
STAGING_DB_URL=postgresql://user:password@host:port/your_staging_db_name

PROD_DB_NAME=your_prod_db_name
PROD_DB_USER=your_prod_db_user
PROD_DB_PASS=your_prod_db_password
PROD_DB_HOST=your_prod_db_host
PROD_DB_PORT=5432
PROD_DB_URL=postgresql://user:password@host:port/dbname

# Medicine catalogue database
MEDICINE_DB_NAME=your_medicine_db_name
MEDICINE_DB_USER=your_medicine_db_user
MEDICINE_DB_PASS=your_medicine_db_password
MEDICINE_DB_HOST=your_medicine_db_host
MEDICINE_DB_URL=postgresql://user:password@host:port/your_medicine_db_name

# ── Redis & background queues ───────────────────────────────────────────────
REDIS_HOST=localhost
# Host-run dev server: use the published dev port (6380), not 6379
REDIS_PORT=6380
REDIS_PASSWORD=
# BullMQ queue DB index (drain queues before changing)
# REDIS_QUEUE_DB=0
# QUEUE_TICK_ENABLED=true
# ENABLE_LOGIN_ALERTS_QUEUE=true
# ENABLE_PRESCRIPTION_MEDICINE_QUEUE=true

# ── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtppro.zoho.in
SMTP_PORT=465
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM='Your Name <no-reply@example.com>'
# EMAIL_MAX_RETRIES=3
# EMAIL_RETRY_BASE_MS=500
# Base URL for images in emails (defaults to BACKEND_BASE_URL)
# EMAIL_ASSET_BASE_URL=
# SUPPORT_EMAIL=support@infinitymedisetu.com
# SUPPORT_PHONE=+91 8770553894

# ── SMS / OTP (India DLT) ───────────────────────────────────────────────────
DLT_ENTITY_ID=your_dlt_entity_id
DLT_SENDER_ID=your_dlt_sender_id
DLT_TEMPLATE_PATIENT_MOBILE_VERIFICATION=your_template_id
DLT_TEMPLATE_PATIENT_MOBILE_VERIFICATION_RESEND=your_template_id
DLT_TEMPLATE_ADMIN_MOBILE_VERIFICATION=your_template_id
DLT_TEMPLATE_ADMIN_MOBILE_VERIFICATION_RESEND=your_template_id
# true = always use OTP_FIXED and skip SMS (never in prod)
OTP_BYPASS_ENABLED=true
# Mobile allowed to use the bypass; "" disables it
BYPASS_TEST_MOBILE=Test_mobile_number
OTP_FIXED=000000
OTP_EXPIRY_MS=600000
OTP_RESEND_COOLDOWN_SECS=60
OTP_MAX_RESEND_COUNT=5
OTP_RATE_REDIS_PREFIX=patient:otp_rate
OTP_RATE_WINDOW_SECS=600
OTP_MAX_ATTEMPTS_PER_WINDOW=5

# ── AWS (S3 files + SNS push/SMS) ───────────────────────────────────────────
AWS_ACCESS_TOKEN=your_aws_access_key
AWS_SECRET_TOKEN=your_aws_secret_key
AWS_REGION=ap-south-1
# One shared bucket; code prefixes objects per NODE_ENV (production/, staging/, development/)
AWS_BUCKET_NAME=your_bucket_name
DEV_AWS_BUCKET_NAME=your_bucket_name
STAGING_AWS_BUCKET_NAME=your_bucket_name
PROD_AWS_BUCKET_NAME=your_bucket_name
# SNS platform apps for mobile push (empty = push disabled for that platform)
SNS_PLATFORM_APPLICATION_ARN_ANDROID=
SNS_PLATFORM_APPLICATION_ARN_IOS=

# ── WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_whatsapp_webhook_verify_token
# Verifies X-Hub-Signature-256 on incoming webhooks
WHATSAPP_APP_SECRET=your_whatsapp_app_secret
WHATSAPP_API_VERSION=v25.0
# Must match the language the templates were approved in
WHATSAPP_LANGUAGE_CODE=en
# Default: on everywhere except staging (so staging never messages real patients)
# WHATSAPP_SENDING_ENABLED=true
# Ignores each clinic's WhatsApp opt-in — never set in prod
# WHATSAPP_FORCE_ENABLED=false
# Templates sent via the notification registry (comma-separated; empty = old code). Keys: appointmentBooked, appointmentRescheduled, appointmentNoShow
# WHATSAPP_VIA_REGISTRY=appointmentBooked
# Approved template names (defaults shown; bodies in docs/WHATSAPP_META_SETUP.md)
WHATSAPP_TEMPLATE_APPOINTMENT_BOOKED=appointment_booked
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=appointment_reminder
WHATSAPP_TEMPLATE_APPOINTMENT_RESCHEDULED=appointment_rescheduled
WHATSAPP_TEMPLATE_APPOINTMENT_NO_SHOW=appointment_no_show
WHATSAPP_TEMPLATE_APPOINTMENT_COMPLETED=appointment_completed
WHATSAPP_TEMPLATE_APPOINTMENT_FOLLOWUP=appointment_followup
WHATSAPP_TEMPLATE_LAB_REPORT_READY=lab_report_ready
WHATSAPP_TEMPLATE_LAB_PAYMENT_RECEIVED=lab_payment_received
WHATSAPP_TEMPLATE_PHARMACY_INVOICE=pharmacy_invoice

# ── Notifications ───────────────────────────────────────────────────────────
ENABLE_NOTIFICATIONS=true
# Days to keep read notifications (min 7)
# NOTIFICATION_RETENTION_DAYS=90
# Days to keep activity/audit rows (min 7)
# NOTIFICATION_ACTIVITY_RETENTION_DAYS=365

# ── Payments ────────────────────────────────────────────────────────────────
# razorpay | cashfree
DEFAULT_PLATFORM_GATEWAY=razorpay
# Comma-separated: razorpay, cashfree
ENABLED_PAYMENT_GATEWAYS=razorpay
PAYMENT_LOCK_TTL_SECONDS=600
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_subscription_webhook_secret
RAZORPAY_WEBHOOK_APP_SECRET=your_appointment_webhook_secret
# true = split payments to clinic linked accounts; false = central account
ENABLE_RAZORPAY_ROUTE=true
# SANDBOX | PRODUCTION
CASHFREE_ENV=SANDBOX
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
# Defaults to CASHFREE_SECRET_KEY
# CASHFREE_WEBHOOK_SECRET=

# ── AI & translation ────────────────────────────────────────────────────────
MODEL_NAME=gemini-flash-latest
GEMINI_API_KEY=your_gemini_api_key
TESTING=false
# none | gemini | bhashini
TRANSLATION_PROVIDER=none
TRANSLATION_FALLBACK=none
TRANSLATION_MODEL_NAME=gemini-2.5-flash
# Vertex via service account (also set GOOGLE_APPLICATION_CREDENTIALS); blank = use GEMINI_API_KEY
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key

# ── 1mg medicine API ────────────────────────────────────────────────────────
ONE_MG_BASE_URL=https://api.1mg.com
ONE_MG_ACCESS_KEY=your_1mg_access_key
# ONE_MG_PLATFORM=mobileweb-0.0.1
# Signing key: file path, or PRIVATE_KEY with the key inline
PRIVATE_KEY_PATH=./private.key
# PRIVATE_KEY=
JWT_KID=my-key-1
JWT_EXP_SECONDS=900
# DRUG_STATIC_CACHE_TTL_MS=300000

# ── Other integrations ──────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
THIRD_PARTY_API_KEY=your_third_party_api_key
# QR on prescriptions (defaults to the Play Store listing)
# PRESCRIPTION_QR_URL=https://play.google.com/store/apps/details?id=com.infinity.medisetu

# ── Security ────────────────────────────────────────────────────────────────
# 64-char hex (32 bytes) for AES-256-GCM encryption of TOTP secrets
MFA_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here_replace_me_with_real_key_00

# ── PDF rendering ───────────────────────────────────────────────────────────
# Chrome binary for PDF generation (auto-detected if unset)
# CHROME_PATH=
